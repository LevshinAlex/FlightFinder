# ---------- Database / Queue ----------
DATABASE_URL=postgresql://flight:flight@localhost:5432/flightfinder?schema=public
REDIS_URL=redis://localhost:6379

# ---------- API ----------
API_PORT=4000
WEB_URL=http://localhost:3000
JWT_SECRET=change-me-to-a-long-random-string
# Manual search rate limit: minimum minutes between manual searches per tracker
MANUAL_SEARCH_COOLDOWN_MINUTES=15

# ---------- Flight providers ----------
# Each may list several, in priority order (comma-separated):
# INDICATIVE_PROVIDER: mock | travelpayouts | ignav   — later ones fill combinations the earlier ones had no price for
#   (ignav = calendar prices: only choose what to live-check, never stored – needs a LIVE_PROVIDER)
# LIVE_PROVIDER: mock | duffel | serpapi | ignav | hasdata | kiwi | flightpowers | skyscanner_scraper   — later ones take over only if earlier ones fail
#   (a provider whose free quota for today is used up is skipped – see PROVIDER_MONTHLY_LIMITS)
# CONTROL_PROVIDER (optional): re-checks the cheapest live result with an independent source
INDICATIVE_PROVIDER=mock
LIVE_PROVIDER=mock
# mock only: simulated provider response time in ms (demo / UI checks; real providers take 10–40 s)
MOCK_LATENCY_MS=0
CONTROL_PROVIDER=
# How many most promising combinations get a live price check (stage 2)
LIVE_CHECK_TOP_N=10
# false → live-check only the top-N per tracker (no extra check per destination airport):
# a fixed daily budget = trackers × LIVE_CHECK_TOP_N requests
LIVE_AIRPORT_PROBES=true
# Max concurrent requests to an external provider
PROVIDER_CONCURRENCY=4
# Max wait for one provider request, seconds: a slower provider is skipped (the next one takes over), never retried.
PROVIDER_TIMEOUT_SECONDS=30
# Cache TTL for identical search queries (minutes)
SEARCH_CACHE_TTL_MINUTES=180

TRAVELPAYOUTS_TOKEN=
TRAVELPAYOUTS_MARKER=
DUFFEL_ACCESS_TOKEN=
SKYSCANNER_API_KEY=
# Free tiers (live search): SerpApi 250 searches/month, Ignav 1000 requests, HasData 1000 credits/month
SERPAPI_KEY=
IGNAV_API_KEY=
HASDATA_API_KEY=
# One RapidAPI key for all RapidAPI listings (subscribe to each listing's free BASIC plan):
#   kiwi = "Kiwi.com Flights API" (300 requests/month, 1 per live check)
#   flightpowers = "Google Flights Live API" by FlightPowers (50 requests/month, 1 per live check, Google price band)
#   skyscanner_scraper = "Skyscanner Scraper" by OmkarCloud (1000 requests/month, 1 per live check, ~11 s)
RAPIDAPI_KEY=
# Ignav prices in the currency of this point-of-sale market (IL = what travellers from Israel pay); converted to USD
IGNAV_MARKET=IL
# Skyscanner point of sale for skyscanner_scraper (changes fares, not only the language)
SKYSCANNER_MARKET=IL

# ---------- Free quotas ----------
# Monthly free quota per provider in its billing units (SerpApi searches, HasData credits, RapidAPI requests).
# Built-in defaults: serpapi:250, hasdata:1000, kiwi:300, flightpowers:50, skyscanner_scraper:1000. 0 = unlimited. RapidAPI's own counter (response headers) wins.
PROVIDER_MONTHLY_LIMITS=
# true → each day may spend at most (left this month) / (days left), so a quota lasts the whole month
PROVIDER_DAILY_PACING=true

# ---------- Currency ----------
# All prices are stored, compared and shown in this currency; quotes in other currencies are converted
BASE_CURRENCY=USD
# Exchange rates (no key, no quota, no attribution)
FX_RATES_URL=https://api.frankfurter.dev/v2/rates?base=USD

# ---------- Notifications ----------
# console | resend
EMAIL_TRANSPORT=console
RESEND_API_KEY=
EMAIL_FROM="Flight Tracker <reports@example.com>"

WHATSAPP_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=daily_flight_summary
WHATSAPP_TEMPLATE_LANG=en

# ---------- Google OAuth (optional) ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must point to the WEB origin (proxied to the API) so the auth cookie is set for the site
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# ---------- Monitoring ----------
SENTRY_DSN=

# ---------- Web ----------
API_INTERNAL_URL=http://localhost:4000
