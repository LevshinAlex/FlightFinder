# ---------- Database / Queue ----------
DATABASE_URL=postgresql://flight:flight@localhost:5432/flightfinder?schema=public
REDIS_URL=redis://localhost:6379

# ---------- API ----------
API_PORT=4000
WEB_URL=http://localhost:3000
JWT_SECRET=change-me-to-a-long-random-string
# Manual search rate limit: minimum minutes between manual searches per tracker
MANUAL_SEARCH_COOLDOWN_MINUTES=15

# ---------- Flight providers ----------
# INDICATIVE_PROVIDER: mock | travelpayouts
# LIVE_PROVIDER: mock | duffel | serpapi | ignav | hasdata  (skyscanner = stub)
INDICATIVE_PROVIDER=mock
LIVE_PROVIDER=mock
# How many most promising combinations get a live price check (stage 2)
LIVE_CHECK_TOP_N=10
# Max concurrent requests to an external provider
PROVIDER_CONCURRENCY=4
# Cache TTL for identical search queries (minutes)
SEARCH_CACHE_TTL_MINUTES=180

TRAVELPAYOUTS_TOKEN=
TRAVELPAYOUTS_MARKER=
DUFFEL_ACCESS_TOKEN=
SKYSCANNER_API_KEY=
# Free tiers (live search): SerpApi 250 searches/month, Ignav 1000 requests, HasData 1000 credits/month
SERPAPI_KEY=
IGNAV_API_KEY=
HASDATA_API_KEY=

# ---------- Notifications ----------
# console | resend
EMAIL_TRANSPORT=console
RESEND_API_KEY=
EMAIL_FROM="Flight Tracker <reports@example.com>"

WHATSAPP_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=daily_flight_summary
WHATSAPP_TEMPLATE_LANG=en

# ---------- Google OAuth (optional) ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must point to the WEB origin (proxied to the API) so the auth cookie is set for the site
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# ---------- Monitoring ----------
SENTRY_DSN=

# ---------- Web ----------
API_INTERNAL_URL=http://localhost:4000
