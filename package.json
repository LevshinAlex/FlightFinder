{
  "name": "flight-finder",
  "private": true,
  "version": "1.0.0",
  "description": "Flight Price Tracker — automatic daily flight price monitoring",
  "workspaces": ["apps/api", "apps/web"],
  "scripts": {
    "dev:api": "npm run start:dev -w apps/api",
    "dev:worker": "npm run worker:dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "build": "npm run build -w apps/api && npm run build -w apps/web",
    "test": "npm test -w apps/api",
    "db:migrate": "npm run prisma:migrate -w apps/api",
    "db:seed": "npm run prisma:seed -w apps/api"
  }
}
